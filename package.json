{
  "name": "nmb-notes",
  "productName": "NMB Notes",
  "version": "1.1.0",
  "description": "Локальный Markdown-редактор с четырьмя колонками, AI-помощником DeepSeek, виджетами и темами Obsidian",
  "main": "electron/main.js",
  "author": "NMB Notes",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "check": "node scripts/check.js",
    "icon": "node scripts/make-icon.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.nmb.notes",
    "productName": "NMB Notes",
    "copyright": "Copyright © 2026 NMB Notes",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "extraMetadata": {
      "name": "nmb-notes"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "NMB-Notes-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "NMB Notes ${version}",
      "contents": [
        {
          "x": 140,
          "y": 220
        },
        {
          "x": 400,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NMB-Notes-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NMB Notes",
      "artifactName": "NMB-Notes-${version}-win-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "artifactName": "NMB-Notes-${version}-linux-${arch}.${ext}"
    },
    "afterPack": "scripts/after-pack.js"
  }
}
